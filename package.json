{
  "name": "ai-interviewer-backend",
  "version": "1.0.0",
  "description": "AI Interview Platform backend — Firebase Functions",
  "private": true,
  "scripts": {
    "dev": "npm --prefix functions run dev",
    "build": "npm --prefix functions run build",
    "start": "npm --prefix functions run start",
    "start:prod": "npm --prefix functions run start:prod",
    "deploy-firestore": "firebase deploy --only firestore:indexes --project=interview-prod-dd24f",
    "deploy-functions": "firebase deploy --only functions --force --project=interview-prod-dd24f",
    "emulators:start": "firebase emulators:start --project=interview-prod-dd24f",
    "sync:secrets": "node scripts/sync-firebase-secrets.js",
    "sync:firebase-config": "node scripts/sync-env-to-firestore.js",
    "seed": "node scripts/seed.js",
    "seed:career-catalog": "node scripts/seed-career-catalog.js",
    "seed:coding": "node scripts/seed-coding-problems.js",
    "seed:achievements": "node scripts/seed-achievements.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "firebase-admin": "^13.10.0",
    "puppeteer-core": "^25.3.0"
  }
}