{
  "name": "ai-interviewer-backend",
  "version": "1.0.0",
  "description": "AI Interview Platform backend — Firebase Functions",
  "private": true,
  "scripts": {
    "dev": "npm --prefix functions run dev",
    "dev:dev": "npm --prefix functions run dev:dev",
    "dev:prod": "npm --prefix functions run dev:prod",
    "build": "npm --prefix functions run build",
    "start": "npm --prefix functions run start",
    "start:prod": "npm --prefix functions run start:prod",
    "deploy-firestore": "firebase deploy --only firestore:indexes --project=production",
    "deploy-firestore:dev": "firebase deploy --only firestore:indexes --project=dev",
    "deploy-storage": "firebase deploy --only storage --project=production",
    "deploy-storage:dev": "firebase deploy --only storage --project=dev",
    "deploy-functions": "firebase deploy --only functions --force --project=production",
    "deploy-functions:dev": "firebase deploy --only functions --force --project=dev",
    "deploy:trigger:user-deleted": "firebase deploy --only functions:onUserDeleted --project=production",
    "deploy:trigger:user-deleted:dev": "firebase deploy --only functions:onUserDeleted --project=dev",
    "deploy-websocket": "gcloud builds submit --tag gcr.io/interview-prod-dd24f/interview-websocket:latest && gcloud run deploy interview-websocket --image gcr.io/interview-prod-dd24f/interview-websocket:latest --region us-central1 --platform managed --allow-unauthenticated --timeout=3600 --session-affinity --set-env-vars \"^@^NODE_ENV=production@STORAGE_BUCKET=interview-prod-dd24f.firebasestorage.app@GEMINI_MODEL=gemini-2.0-flash@GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025@CORS_ORIGIN=https://app.interviewup.ai,https://www.app.interviewup.ai,https://interview-prod-dd24f.web.app,https://interview-prod-dd24f.firebaseapp.com\" --project=interview-prod-dd24f",
    "emulators:start": "firebase emulators:start --project=production",
    "emulators:start:dev": "firebase emulators:start --project=dev",
    "sync:secrets": "node scripts/sync-firebase-secrets.js",
    "sync:firebase-config": "node scripts/sync-env-to-firestore.js --env=dev",
    "sync:firebase-config:dev": "node scripts/sync-env-to-firestore.js --env=dev",
    "sync:firebase-config:prod": "node scripts/sync-env-to-firestore.js --env=prod",
    "seed": "node scripts/seed.js",
    "seed:plans": "node scripts/seed-plans.js --env=dev",
    "seed:plans:dev": "node scripts/seed-plans.js --env=dev",
    "seed:plans:prod": "node scripts/seed-plans.js --env=prod",
    "seed:career-catalog": "node scripts/seed-career-catalog.js",
    "seed:coding": "node scripts/seed-coding-problems.js",
    "seed:achievements": "node scripts/seed-achievements.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "firebase-admin": "^13.10.0",
    "puppeteer-core": "^25.3.0"
  }
}