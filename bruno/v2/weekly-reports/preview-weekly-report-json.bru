meta {
  name: Preview Weekly Report JSON (test@mailinator.com)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v2/admin/weekly-reports/preview/test@mailinator.com
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("status code is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("contains user and metrics data", function() {
    const body = res.getBody();
    expect(body.success).to.be.true;
    expect(body.data.reportData.recipientEmail).to.equal('test@mailinator.com');
  });
}
