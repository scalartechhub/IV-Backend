PORT=5000
NODE_ENV=production

# Comma-separated list of allowed production origins (e.g. Vercel, Firebase Hosting, Netlify, Custom Domain)
CORS_ORIGIN=https://interview-89e09.web.app,https://your-frontend-domain.com

# Firebase Production Config
FIREBASE_PROJECT_ID=interview-89e09
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_STORAGE_BUCKET=interview-89e09.firebasestorage.app

# Firebase Admin Service Account (Required if running standalone Node server, e.g. Render/Railway/Docker)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@interview-89e09.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Gemini AI (Production Key)
GEMINI_API_KEY=your_production_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Groq AI
GROQ_API_KEY=your_production_groq_api_key

# Razorpay Payments (Production Keys)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_live_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# SendGrid Email Service
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@scalartechhub.com

# Judge0 CE (Hosted Judge0 endpoint or local docker cluster)
JUDGE0_URL=https://your-judge0-instance.com
