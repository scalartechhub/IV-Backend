# Server & Environment
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://app.interviewup.ai,https://www.app.interviewup.ai,http://localhost:4200

# Firebase Credentials
FB_PROJECT_ID=interview-prod-dd24f
FB_API_KEY=your-firebase-api-key
FB_STORAGE_BUCKET=interview-prod-dd24f.firebasestorage.app
FB_AUTH_DOMAIN=interview-prod-dd24f.firebaseapp.com
FB_MESSAGING_SENDER_ID=your-sender-id
FB_APP_ID=your-app-id
FB_MEASUREMENT_ID=your-measurement-id

# Gemini AI Configuration (Required by sync-env-to-firestore)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_VOICE_NAME=Charon
GEMINI_TIMEOUT_MS=120000
RESUME_GEMINI_MODEL=gemini-2.0-flash

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Groq AI Service
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# SendGrid Email Service
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
OWNER_EMAIL=admin@yourdomain.com

# Judge0 Code Execution API
JUDGE0_URL=http://localhost:2358/