# Server & Environment
PORT=5000
NODE_ENV=production
CORS_ORIGIN=https://app.interviewup.ai,https://www.app.interviewup.ai,http://localhost:4200
IV_FRONTEND_URL=https://app.interviewup.ai

# Firebase Credentials
FB_PROJECT_ID=your-firebase-project-id
FB_API_KEY=your-firebase-api-key
FB_STORAGE_BUCKET=your-project.firebasestorage.app
FB_AUTH_DOMAIN=your-project.firebaseapp.com
FB_MESSAGING_SENDER_ID=your-sender-id
FB_APP_ID=your-app-id
FB_MEASUREMENT_ID=your-measurement-id

FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_MESSAGING_SENDER_ID=your-sender-id
FIREBASE_APP_ID=your-app-id
FIREBASE_MEASUREMENT_ID=your-measurement-id

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-2.0-flash
GEMINI_VOICE_NAME=Charon
GEMINI_TIMEOUT_MS=120000
RESUME_GEMINI_MODEL=gemini-3.6-flash

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
RAZORPAY_PRO_MONTHLY_PLAN_ID=plan_xxxxxx
RAZORPAY_PRO_YEARLY_PLAN_ID=plan_xxxxxx
RAZORPAY_ELITE_MONTHLY_PLAN_ID=plan_xxxxxx
RAZORPAY_ELITE_YEARLY_PLAN_ID=plan_xxxxxx

# Groq AI Service
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Email Service (Nodemailer / SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-google-app-password
SMTP_FROM="InterviewUp <your-email@gmail.com>"
OWNER_EMAIL=admin@yourdomain.com

# Judge0 Code Execution API
JUDGE0_URL=http://localhost:2358/

# Discord Notifications (Optional)
DISCORD_WEBHOOK_URL=

# OpenStreetMap / Overpass API (Nearby Companies)
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_MS=25000