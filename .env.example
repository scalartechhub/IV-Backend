PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200,http://localhost:5173,https://interview-89e09.web.app

# Firebase
FIREBASE_API_KEY=
FIREBASE_STORAGE_BUCKET=


# Gemini AI
GEMINI_API_KEY=
# Text scoring / resume / roadmap (gemini-2.5-flash is blocked for many new API keys)
GEMINI_MODEL=gemini-3.6-flash
# Optional faster model for resume ATS (defaults to GEMINI_MODEL)
# RESUME_GEMINI_MODEL=gemini-3.1-flash-lite

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

GROQ_API_KEY=

# SendGrid (email)
SENDGRID_API_KEY=
# Must be a NON-Gmail address verified in SendGrid Single Sender Verification.
# e.g. noreply@scalartechhub.com  (Gmail addresses fail DMARC when sent via SendGrid)
SENDGRID_FROM_EMAIL=

# Judge0 CE (local docker compose in judge0/)
JUDGE0_URL=http://localhost:2358